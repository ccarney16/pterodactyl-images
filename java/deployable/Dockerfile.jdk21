FROM --platform=$TARGETOS/$TARGETARCH docker.io/library/eclipse-temurin:21

LABEL author="Cameron Carney" maintainer="ccarney16@live.com"
LABEL org.opencontainers.image.source="https://github.com/ccarney16/pterodactyl-images"

RUN apt-get update -y \
    && apt-get install -y \
        moreutils \
        gettext-base \
        lsof \
        curl \
        ca-certificates \
        openssl \
        git \
        git-lfs \
        tar \
        sqlite3 \
        fontconfig \
        libfreetype6 \
        tzdata \
        iproute2 \
        libstdc++6 \
    && useradd -d /home/container -m container \
    && curl -Lo /usr/local/bin/ytt https://github.com/vmware-tanzu/carvel-ytt/releases/download/v0.55.3/ytt-linux-amd64 \
    && curl -Lo /usr/local/bin/vendir https://github.com/vmware-tanzu/carvel-vendir/releases/download/v0.46.2/vendir-linux-amd64 \
    && chmod +x /usr/local/bin/ytt /usr/local/bin/vendir

USER container
ENV USER=container HOME=/home/container
WORKDIR /home/container

COPY ./../entrypoints/deploy.sh /entrypoint.sh
CMD ["/bin/bash", "/entrypoint.sh"]
